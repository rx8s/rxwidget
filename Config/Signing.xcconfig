// การ sign โค้ดของ rxwidget (Apple Personal Team ฟรี)
//
// ใส่ Team ID 10 ตัวของ Personal Team ตรงนี้ (Xcode → Settings → Accounts)
// App Group จะเป็น "<TEAMID>.rxwidget" อัตโนมัติ
DEVELOPMENT_TEAM = <TEAMID>

BUNDLE_ID_PREFIX = com.rx8s
APP_GROUP_ID = $(DEVELOPMENT_TEAM).rxwidget

// iOS บังคับให้ App Group ขึ้นต้นด้วย "group." และต้องลงทะเบียนกับ Apple (Xcode ทำให้อัตโนมัติ)
APP_GROUP_ID_IOS = group.$(BUNDLE_ID_PREFIX).rxwidget
